{
  "name": "anime-shelf",
  "version": "1.0.0",
  "license": "MIT",
  "description": "本地动漫/影视管理器，带海报墙效果",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "server:dev": "node scripts/dev-server.mjs",
    "client:dev": "vite --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "modules:generate": "node scripts/modules.mjs",
    "verify:modules": "node scripts/verify-modules.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "build:server": "node scripts/build-server.mjs",
    "db:repair": "node scripts/repair-db.mjs",
    "electron:dev": "set ANIMESHELF_DEV=1&& electron .",
    "build:electron": "pnpm run build && node scripts/build-server.mjs && node scripts/generate-notices.mjs && electron-builder --win portable && node scripts/copy-release.mjs"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "bangumi-data": "^0.3.217",
    "cheerio": "1.1.2",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "node-sqlite3-wasm": "^0.8.59",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.24.1",
    "undici": "7.29.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "postcss": "^8.4.39",
    "puppeteer-core": "^25.5.0",
    "tailwindcss": "^3.4.6",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vite": "^5.3.3",
    "vitest": "3.2.7",
    "selfsigned": "5.5.0"
  },
  "main": "electron/main.cjs",
  "packageManager": "pnpm@11.7.0",
  "build": {
    "appId": "com.animeshelf.app",
    "productName": "AnimeShelf",
    "files": [
      "electron/**",
      "dist-electron/**",
      "dist/assets/**",
      "dist/index.html",
      "LICENSE",
      "THIRD-PARTY-NOTICES.txt",
      "licenses/**",
      "docs/THIRD-PARTY.md",
      "docs/ASSET-PROVENANCE.md",
      "docs/PRIVACY.md",
      "!**/__tests__/**",
      "!dist/win-unpacked/**",
      "!dist/AnimeShelf-*.exe"
    ],
    "asarUnpack": [
      "node_modules/node-sqlite3-wasm/**"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "AnimeShelf-${version}-portable.exe"
    }
  }
}
